    {
      "parameters": {
        "jsCode": "// Servis yaniti (POST /karar/calistir) -> ortak alanlar\nreturn $input.all().map(item => {\n  const s = item.json, c = s.cikti || {}, o = s.ozet || {};\n  const uyari = c.veri_uyarilari || [];\n  return { json: {\n    gun: o.gun, status: c.durum, decision: c.karar, priority: c.oncelik,\n    tightest_hour: o.en_dar_saat, min_margin: o.en_dusuk_marj, min_margin_conservative: o.en_dusuk_marj_temkinli,\n    summary: c.ozet || '', reasons: (c.gerekceler || []).join(' | '),\n    citations: (c.mevzuat_atiflari || []).map(a => `${a.belge} ${a.madde}`).join(' | '),\n    data_warnings: uyari.join(' | '), warnings_count: uyari.length,\n    model: o.model || '', model_version: s.model_surumu || '', source: 'servis'\n  }};\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        400
      ],
